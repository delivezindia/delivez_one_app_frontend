  "item": [
    {
      "name": "1. Authentication",
      "description": "Login requests to obtain access tokens. Automated test scripts update both collectionVariables and environmentVariables.",
      "item": [
        {
          "name": "1.1 User Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "var token = json.data && (json.data.accessToken || json.data.token);",
                  "if (token) {",
                  "    pm.collectionVariables.set(\"accessToken\", token);",
                  "    pm.environment.set(\"accessToken\", token);",
                  "    console.log(\"accessToken updated: \" + token.substring(0, 15) + \"...\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"countryCode\": \"+91\",\n  \"mobileNumber\": \"{{userMobile}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Logs in customer user and stores {{accessToken}} directly into collection variables."
          },
          "response": []
        },
        {
          "name": "1.2 Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "var token = json.data && (json.data.accessToken || json.data.token);",
                  "if (token) {",
                  "    pm.collectionVariables.set(\"adminAccessToken\", token);",
                  "    pm.environment.set(\"adminAccessToken\", token);",
                  "    console.log(\"adminAccessToken updated: \" + token.substring(0, 15) + \"...\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/admin/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "auth", "login"]
            },
            "description": "Logs in platform administrator and stores {{adminAccessToken}} directly into collection variables."
          },
          "response": []
        },
        {
          "name": "1.3 Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/profile",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "profile"]
            },
            "description": "Verifies that the {{accessToken}} is active and returns profile information."
          },
          "response": []
        }
