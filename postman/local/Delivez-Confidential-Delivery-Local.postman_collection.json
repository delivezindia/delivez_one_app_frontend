        {
          "name": "2.10 Admin Update Vault Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_TRANSIT\",\n  \"tamperSealIntact\": true,\n  \"notes\": \"Armed courier dispatched from Delvez Vault hub with GPS transponder active.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/confidential-delivery/admin/bookings/{{confidentialBookingId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["confidential-delivery", "admin", "bookings", "{{confidentialBookingId}}", "status"]
            },
            "description": "Platform Admin updates the chain of custody status and tamper condition."
          },
          "response": []
        }
      ]
    }
