    {
      "name": "2. Confidential Delivery (Vault)",
      "description": "End-to-end endpoints for confidential transit, tamper-proof pouches, chain of custody, and dual OTP.",
      "item": [
        {
          "name": "2.1 Get Vault Options",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/confidential-delivery/options",
              "host": ["{{baseUrl}}"],
              "path": ["confidential-delivery", "options"]
            },
            "description": "Returns security levels (Standard, Enhanced, Maximum Security), tamper-proof pouch options, and verification methods."
          },
          "response": []
        },
        {
          "name": "2.2 Calculate Vault Quote",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickup\": {\n    \"addressLine1\": \"Advocates Chambers, High Court Complex\",\n    \"city\": \"Bengaluru\",\n    \"state\": \"Karnataka\",\n    \"postalCode\": \"560001\",\n    \"latitude\": 12.9778,\n    \"longitude\": 77.5926\n  },\n  \"dropoff\": {\n    \"addressLine1\": \"KPMG Corporate Office, Embassy GolfLinks\",\n    \"city\": \"Bengaluru\",\n    \"state\": \"Karnataka\",\n    \"postalCode\": \"560071\",\n    \"latitude\": 12.9538,\n    \"longitude\": 77.6484\n  },\n  \"securityLevel\": \"MAXIMUM_SECURITY\",\n  \"packagingType\": \"TAMPER_PROOF_POUCH\",\n  \"verificationMethod\": \"OTP\",\n  \"serviceType\": \"VAULT_SECURE\",\n  \"addonProtections\": [\n    \"EXTRA_BUBBLE_WRAP\",\n    \"SEAL_SECURITY_TAPE\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/confidential-delivery/quote",
              "host": ["{{baseUrl}}"],
              "path": ["confidential-delivery", "quote"]
            },
            "description": "Calculates real-time quote including security handling, tamper-evident seals, and specialized armed escort fees."
          },
          "response": []
        },
        {
          "name": "2.3 Create Vault Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Vault booking created successfully\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "var json = pm.response.json();",
                  "var b = (json.data && json.data.booking) || json.data;",
                  "if (b && b.id) {",
                  "    pm.collectionVariables.set(\"confidentialBookingId\", b.id);",
                  "    pm.environment.set(\"confidentialBookingId\", b.id);",
                  "    var vid = b.vaultId || b.trackingId || b.id;",
                  "    pm.collectionVariables.set(\"vaultId\", vid);",
                  "    pm.environment.set(\"vaultId\", vid);",
                  "    console.log(\"Saved confidentialBookingId: \" + b.id + \" and vaultId: \" + vid);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "idemp-vault-{{$timestamp}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickup\": {\n    \"contactName\": \"Advocate Ramesh Sen\",\n    \"phoneNumber\": \"+919876543220\",\n    \"addressLine1\": \"High Court Complex, Chamber 14\",\n    \"city\": \"Bengaluru\",\n    \"state\": \"Karnataka\",\n    \"postalCode\": \"560001\",\n    \"latitude\": 12.9778,\n    \"longitude\": 77.5926\n  },\n  \"delivery\": {\n    \"contactName\": \"Director Anita Roy\",\n    \"phoneNumber\": \"+919876543221\",\n    \"addressLine1\": \"Embassy GolfLinks Business Park, Pebble Beach\",\n    \"addressLine2\": \"3rd Floor Legal Wing\",\n    \"city\": \"Bengaluru\",\n    \"state\": \"Karnataka\",\n    \"postalCode\": \"560071\",\n    \"latitude\": 12.9538,\n    \"longitude\": 77.6484\n  },\n  \"dropoff\": {\n    \"contactName\": \"Director Anita Roy\",\n    \"phoneNumber\": \"+919876543221\",\n    \"addressLine1\": \"Embassy GolfLinks Business Park, Pebble Beach\",\n    \"addressLine2\": \"3rd Floor Legal Wing\",\n    \"city\": \"Bengaluru\",\n    \"state\": \"Karnataka\",\n    \"postalCode\": \"560071\",\n    \"latitude\": 12.9538,\n    \"longitude\": 77.6484\n  },\n  \"securityLevel\": \"MAXIMUM_SECURITY\",\n  \"packagingType\": \"TAMPER_PROOF_POUCH\",\n  \"verificationMethod\": \"OTP\",\n  \"itemDescription\": \"Original Deed Agreement & Legal Records\",\n  \"handlingInstructions\": \"Do not fold, direct handoff only to Anita Roy with ID check.\",\n  \"paymentMethod\": \"ONLINE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/confidential-delivery/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["confidential-delivery", "bookings"]
            },
            "description": "Creates a confidential vault shipment and saves {{confidentialBookingId}} and {{vaultId}} into variables."
          },
          "response": []
        },
