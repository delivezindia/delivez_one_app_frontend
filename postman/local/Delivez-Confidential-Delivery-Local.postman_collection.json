                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/confidential-delivery/bookings/{{confidentialBookingId}}/payments/sandbox",
              "host": ["{{baseUrl}}"],
              "path": ["confidential-delivery", "bookings", "{{confidentialBookingId}}", "payments", "sandbox"]
            },
            "description": "Completes sandbox payment transaction for confidential vault delivery."
          },
          "response": []
