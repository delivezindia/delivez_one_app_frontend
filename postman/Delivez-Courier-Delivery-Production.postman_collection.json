                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serviceName\": \"Local Delivery\",\n  \"speed\": \"Bike Priority Delivery\",\n  \"pickup\": {\n    \"address\": \"B-1204, Lodha Park, Ghatkopar East, Mumbai 400077\",\n    \"pincode\": \"400077\",\n    \"preferredTime\": \"ASAP\"\n  },\n  \"dropoff\": {\n    \"address\": \"DLF Cyber City, Tower A, 6th Floor, Gurugram 122002\",\n    \"pincode\": \"122002\"\n  },\n  \"package\": {\n    \"category\": \"Documents\",\n    \"boxRequired\": true,\n    \"boxSize\": \"Small Box\",\n    \"weightCapacity\": \"10 Kg\",\n    \"actualWeightKg\": 2.5,\n    \"dimensions\": {\n      \"length\": 30,\n      \"width\": 20,\n      \"height\": 20\n    }\n  },\n  \"safeguards\": {\n    \"isFragile\": false,\n    \"isSecure\": true\n  },\n  \"insurance\": {\n    \"option\": \"FULL_COVERAGE\",\n    \"declaredValue\": 25000\n  },\n  \"promoCode\": \"DELIVEZ10\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/courier-delivery/quote",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "courier-delivery",
                "quote"
