    {
      "name": "3. Booking Creation & Management",
      "item": [
        {
          "name": "1. Create Courier Booking (Full 8-Step Payload)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "idemp-courier-{{$timestamp}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serviceType\": \"Local Delivery\",\n  \"deliverySpeed\": \"Bike Priority Delivery\",\n  \"pickup\": {\n    \"title\": \"Home\",\n    \"addressLine\": \"B-1204, Lodha Park, Near Shreyas Cinema, Ghatkopar East, Mumbai 400077\",\n    \"contactPerson\": \"Rahul Sharma\",\n    \"phone\": \"+91 98765 43210\",\n    \"preferredTime\": \"ASAP\"\n  },\n  \"dropoff\": {\n    \"title\": \"Office\",\n    \"addressLine\": \"DLF Cyber City, Tower A, 6th Floor, Gurugram, Haryana 122002\",\n    \"contactPerson\": \"Rohit Mehra\",\n    \"phone\": \"+91 98765 43211\",\n    \"instructions\": \"Please call before arriving\"\n  },\n  \"package\": {\n    \"category\": \"Documents\",\n    \"description\": \"2 books and official legal documents\",\n    \"boxRequired\": \"yes\",\n    \"boxSize\": \"Small Box\",\n    \"weightCapacity\": \"10 Kg\",\n    \"actualWeight\": 2.5,\n    \"dimensions\": {\n      \"length\": 30,\n      \"width\": 20,\n      \"height\": 20\n    },\n    \"isFragile\": false,\n    \"isSecure\": true\n  },\n  \"insurance\": {\n    \"option\": \"FULL_COVERAGE\",\n    \"declaredValue\": 25000,\n    \"premium\": 188\n  },\n  \"pricing\": {\n    \"baseFare\": 120,\n    \"boxFee\": 30,\n    \"handlingFee\": 35,\n    \"insuranceFee\": 188,\n    \"discount\": 50,\n    \"tax\": 58,\n    \"totalPayable\": 381\n  },\n  \"payment\": {\n    \"method\": \"Delivez Money (Wallet)\",\n    \"isGstEnabled\": false\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/courier-delivery/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "courier-delivery",
                "bookings"
              ]
            },
            "description": "Creates a new courier consignment booking and automatically stores {{courierBookingId}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 or 200\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "var res = pm.response.json();",
                  "var id = (res.data && (res.data.bookingId || res.data.id || (res.data.booking && res.data.booking.id))) || res.bookingId || res.id;",
                  "if (id) {",
                  "    pm.collectionVariables.set(\"courierBookingId\", id);",
                  "    pm.environment.set(\"courierBookingId\", id);",
                  "    console.log(\"courierBookingId set: \" + id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
