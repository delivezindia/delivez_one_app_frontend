            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"OUT_FOR_DELIVERY\",\n  \"timestamp\": \"2026-09-12T09:59:39.424Z\",\n  \"actor\": \"Central Fleet Dispatch\",\n  \"note\": \"Package assigned to rider and en-route to destination address\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/admin/courier/bookings/{{courierBookingId}}/status",
              "host": [
