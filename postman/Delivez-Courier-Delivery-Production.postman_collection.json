{
  "info": {
    "_postman_id": "delivez-courier-delivery-prod-v1",
    "name": "Delivez - Courier Delivery API Suite (Production)",
    "description": "Complete, production-ready Postman collection for Personal Courier Delivery matching the Flutter mobile application flow.\\n\\nEnvironment: **Production**\\nBase URL: `http://40.81.244.167:3012/api/v1`\\n\\nFlow Coverage:\\n1. Authentication (Customer Login & Admin Dispatcher)\\n2. Service Options & Address Book (Saved Addresses & Add New)\\n3. Dynamic Quote Calculator (Weight, Dimensions, Boxes, Handling, Insurance)\\n4. Create Courier Booking (Complete 8-step payload with auto-storing `courierBookingId`)\\n5. Booking Details & Status Management\\n6. Real-time GPS Tracking & Milestones\\n7. Proof of Delivery (POD) & OTP Verification\\n8. Payment Sandbox Simulation & Order Cancellation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Authentication",
      "item": [
        {
          "name": "1. Customer Login (Sets accessToken)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"{{userMobile}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Authenticates customer and stores {{accessToken}} automatically into active Postman collection and environment."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var res = pm.response.json();",
                  "var token = (res.data && res.data.accessToken) || res.accessToken || (res.data && res.data.token) || res.token;",
                  "if (token) {",
                  "    pm.collectionVariables.set(\"accessToken\", token);",
                  "    pm.environment.set(\"accessToken\", token);",
                  "    console.log(\"accessToken set successfully\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2. Admin Login (Sets adminAccessToken)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/admin/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "auth",
                "login"
              ]
            },
            "description": "Authenticates platform administrator/dispatcher and stores {{adminAccessToken}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var res = pm.response.json();",
                  "var token = (res.data && res.data.accessToken) || res.accessToken || (res.data && res.data.token) || res.token;",
                  "if (token) {",
                  "    pm.collectionVariables.set(\"adminAccessToken\", token);",
                  "    pm.environment.set(\"adminAccessToken\", token);",
                  "    console.log(\"adminAccessToken set successfully\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "3. Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Returns profile details of the authenticated customer."
          }
        }
      ]
