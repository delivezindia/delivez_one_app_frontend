{
  "info": {
    "_postman_id": "delivez-sliders-knowmore-prod-v1",
    "name": "Delivez - Sliders & Know More (Production Suite)",
    "description": "Production-grade API suite for Delivez:\n1. Service Image Sliders (1 slider per service with multiple images)\n2. Know More Cards (Multiple cards with heading, descriptions, multiple images, and CTA links)\nPre-configured for production environment (http://40.81.244.167:3012/api/v1 / https://api.delivez.com/api/v1) with automated assertions and token handshakes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://40.81.244.167:3012/api/v1",
      "type": "string",
      "description": "Production Server Base URL (Alternate: https://api.delivez.com/api/v1)"
    },
    {
      "key": "adminEmail",
      "value": "admin@delevez.com",
      "type": "string"
    },
    {
      "key": "adminPassword",
      "value": "Admin@123456",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string",
      "description": "Auto-populated upon successful Admin Production Login"
    },
    {
      "key": "sliderServiceSlug",
      "value": "courier-delivery",
      "type": "string"
    },
    {
      "key": "knowMoreCardId",
      "value": "km-card-01",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Production Authentication",
      "item": [
        {
          "name": "1.1 Admin Production Login (Auto-Captures Bearer Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Login returns valid accessToken', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql('success');",
                  "    const token = jsonData?.data?.accessToken || jsonData?.tokens?.accessToken;",
                  "    pm.expect(token).to.be.a('string');",
                  "    pm.collectionVariables.set('adminToken', token);",
                  "    pm.environment.set('adminToken', token);",
                  "    pm.environment.set('adminAccessToken', token);",
                  "    console.log('[PROD] Admin Token acquired successfully.');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "auth",
                "login"
              ]
            },
            "description": "Authenticates admin against production server and populates {{adminToken}}."
          }
        }
      ]
    },
    {
      "name": "2. Service Image Sliders (1 Slider per Service)",
      "description": "Production endpoints for the 5 delivery service banner sliders. Each service has exactly 1 slider containing an array of multiple images.",
      "item": [
        {
          "name": "2.1 Public: Get All Service Image Sliders",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns all 5 services sliders', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql('success');",
                  "    pm.expect(jsonData.data).to.be.an('array');",
                  "    pm.expect(jsonData.data.length).to.be.at.least(5);",
                  "    const slugs = jsonData.data.map(s => s.serviceSlug);",
                  "    pm.expect(slugs).to.include('courier-delivery');",
                  "    pm.expect(slugs).to.include('luggage-delivery');",
                  "    pm.expect(slugs).to.include('confidential-delivery');",
                  "    pm.expect(slugs).to.include('forgot-something');",
                  "    pm.expect(slugs).to.include('return-pickup');",
                  "});",
                  "pm.test('Response time under 1500ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1500);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/services/sliders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "services",
                "sliders"
              ]
            }
          }
        },
