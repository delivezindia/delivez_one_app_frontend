  "item": [
    {
      "name": "1. Location Bar & Geolocation",
      "description": "Auto-detecting current location from user connection / IP, or reverse-geocoding live GPS coordinates.",
      "item": [
        {
          "name": "Get Current Location (Auto-detected via User IP/Connection)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/location/current",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "location",
                "current"
              ]
            },
            "description": "Detects the user's real current city, state, address and postal code using connection IP and reverse geocoding."
          },
          "response": []
        },
        {
          "name": "Get Current Location with GPS Coordinates",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/location/current?lat={{latitude}}&lng={{longitude}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "location",
                "current"
              ],
              "query": [
                {
                  "key": "lat",
                  "value": "{{latitude}}"
                },
                {
                  "key": "lng",
                  "value": "{{longitude}}"
                }
              ]
            },
            "description": "Pass device latitude and longitude to get the exact street, neighbourhood, and postal code."
          },
          "response": []
        },
        {
          "name": "Detect / Reverse-Geocode Coordinates (GET)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/location/detect?lat={{latitude}}&lng={{longitude}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "location",
                "detect"
              ],
              "query": [
                {
                  "key": "lat",
                  "value": "{{latitude}}"
                },
                {
                  "key": "lng",
                  "value": "{{longitude}}"
                }
              ]
            },
            "description": "Reverse geocode coordinates with serviceability check."
          },
          "response": []
        },
        {
          "name": "Detect / Reverse-Geocode Coordinates (POST)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 26.8373,\n  \"longitude\": 80.9165\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/location/detect",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "location",
                "detect"
              ]
            }
          },
          "response": []
        },
