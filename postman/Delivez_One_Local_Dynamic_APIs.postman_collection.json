    {
      "name": "8. Admin Management (Protected)",
      "description": "Admin endpoints to manage Hero texts, image uploads, Quick Actions, Pincodes, Support, and Banner.",
      "item": [
        {
          "name": "1. Admin Login (Auto-saves {{adminToken}})",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && (res.data.accessToken || res.data.token)) {",
                  "  const token = res.data.accessToken || res.data.token;",
                  "  pm.collectionVariables.set(\"adminToken\", token);",
                  "  console.log(\"Admin token saved successfully!\");",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{adminMobile}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "auth",
                "login"
              ]
            }
