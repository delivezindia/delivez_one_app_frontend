            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_TRANSIT\",\n  \"timestamp\": \"2026-09-12T07:37:14.940Z\",\n  \"statusChangedAt\": \"2026-09-12T07:37:14.940Z\",\n  \"updatedAt\": \"2026-09-12T07:37:14.940Z\",\n  \"actor\": \"Admin Dispatcher\",\n  \"note\": \"Transit updated via unified service key route\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/admin/orders/{{serviceKey}}/{{orderId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "orders",
                "{{serviceKey}}",
                "{{orderId}}",
                "status"
              ]
            },
            "description": "Updates status via the unified service router (serviceKey can be courier, luggage-delivery, confidential, forgot, or return)."
          }
        }
      ]
    },
