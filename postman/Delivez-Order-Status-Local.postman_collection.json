            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_TRANSIT\",\n  \"timestamp\": \"2026-09-12T07:37:14.939Z\",\n  \"statusChangedAt\": \"2026-09-12T07:37:14.940Z\",\n  \"updatedAt\": \"2026-09-12T07:37:14.940Z\",\n  \"actor\": \"Admin Operations Dispatcher\",\n  \"note\": \"Consignment departed sorting hub and is in transit\",\n  \"statusTimestamps\": {\n    \"IN_TRANSIT\": \"2026-09-12T07:37:14.940Z\"\n  },\n  \"statusHistory\": [\n    {\n      \"status\": \"IN_TRANSIT\",\n      \"timestamp\": \"2026-09-12T07:37:14.940Z\",\n      \"actor\": \"Admin Operations Dispatcher\",\n      \"note\": \"Consignment departed sorting hub and is in transit\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/admin/orders/{{orderId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "orders",
                "{{orderId}}",
                "status"
              ]
            },
            "description": "Primary universal status endpoint used by orderStatusApi.js to transition any order using only its orderId."
          }
        },
        {
          "name": "4. Update Order Status by Service Key (Unified)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              },
