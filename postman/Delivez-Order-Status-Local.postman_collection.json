{
  "info": {
    "_postman_id": "delivez-order-status-local-v1",
    "name": "Delivez - Order Status API Suite (Localhost)",
    "description": "Comprehensive Postman collection for changing and managing order statuses across all Delivez services.\\n\\nEnvironment: **Localhost**\\nBase URL: `http://localhost:4000/api/v1`\\n\\nIncludes:\\n- Authentication (Admin & Customer tokens)\\n- Direct Universal Status Update API\\n- Unified Order Status by Service Key\\n- Step-by-Step Lifecycle Status Transitions (CONFIRMED, AGENT_ASSIGNED, PICKED_UP, IN_TRANSIT, OUT_FOR_DELIVERY, DELIVERED, CANCELLED)\\n- Partner Assignment & Auto-Dispatch\\n- Service-Specific Status Handlers (Courier, Gift Delivery, Return Pickup, Forgot Something, Confidential Vault)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Authentication",
      "item": [
        {
          "name": "Admin Login (Sets adminAccessToken)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/admin/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "auth",
                "login"
              ]
            },
            "description": "Logs in platform administrator and automatically sets {{adminAccessToken}} into collection and environment variables."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var res = pm.response.json();",
                  "var token = (res.data && res.data.accessToken) || res.accessToken || (res.data && res.data.token) || res.token;",
                  "if (token) {",
                  "    pm.collectionVariables.set(\"adminAccessToken\", token);",
                  "    pm.environment.set(\"adminAccessToken\", token);",
                  "    console.log(\"adminAccessToken set successfully\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Customer Login (Sets accessToken)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"{{userMobile}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Logs in customer user and automatically sets {{accessToken}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var res = pm.response.json();",
                  "var token = (res.data && res.data.accessToken) || res.accessToken || (res.data && res.data.token) || res.token;",
                  "if (token) {",
                  "    pm.collectionVariables.set(\"accessToken\", token);",
                  "    pm.environment.set(\"accessToken\", token);",
                  "    console.log(\"accessToken set successfully\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Universal Status Operations",
      "item": [
        {
          "name": "1. Get Current Order Status & Timings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/orders/{{orderId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "orders",
                "{{orderId}}",
                "status"
              ]
            },
            "description": "Fetches the current lifecycle status, timing timestamps, notes, and full status history for an order."
          }
        },
        {
          "name": "2. Track Order (Universal Track Endpoint)",
