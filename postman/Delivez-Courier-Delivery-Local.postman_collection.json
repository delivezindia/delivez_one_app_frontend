        {
          "name": "3. Admin Dispatcher Transition Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"OUT_FOR_DELIVERY\",\n  \"timestamp\": \"2026-09-14T04:29:27.893Z\",\n  \"actor\": \"Central Fleet Dispatch\",\n  \"note\": \"Package assigned to rider and en-route to destination address\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/admin/courier/bookings/{{courierBookingId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "courier",
                "bookings",
                "{{courierBookingId}}",
                "status"
              ]
            },
            "description": "Admin operational endpoint to update courier status milestones."
          }
        }
      ]
    }
  ],
