            ],
            "url": {
              "raw": "{{baseUrl}}/courier-delivery/bookings/{{courierBookingId}}/pod",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "courier-delivery",
                "bookings",
                "{{courierBookingId}}",
                "pod"
              ]
            },
            "description": "Retrieves digital recipient signature, photo proof, OTP validation record, and delivery completion timestamp."
          }
        },
        {
          "name": "3. Universal Consignment Tracking",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/track/{{courierBookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "track",
                "{{courierBookingId}}"
              ]
            },
            "description": "Public tracking URL accessed by customers or recipients via SMS/Email notifications."
          }
        }
      ]
    },
    {
      "name": "5. Payments, Cancellation & Dispatch Status",
      "item": [
        {
          "name": "1. Complete Sandbox Payment Simulation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentMethod\": \"WALLET\",\n  \"amount\": 381,\n  \"currency\": \"INR\",\n  \"transactionReference\": \"TXN-DELIVEZ-{{$timestamp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/courier-delivery/bookings/{{courierBookingId}}/payments/sandbox",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "courier-delivery",
                "bookings",
                "{{courierBookingId}}",
                "payments",
                "sandbox"
              ]
            },
            "description": "Simulates successful payment completion in development sandbox."
          }
        },
