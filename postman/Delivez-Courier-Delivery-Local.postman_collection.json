                "courier-delivery",
                "bookings",
                "{{courierBookingId}}",
                "track"
              ]
            },
            "description": "Retrieves current shipment status, live rider GPS coordinates, and historical milestone timestamps."
          }
        },
        {
          "name": "2. Get Proof of Delivery (POD)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
