{
  "info": {
    "_postman_id": "delivez-courier-delivery-local-v1",
    "name": "Delivez - Courier Delivery API Suite (Localhost)",
    "description": "Complete, production-ready Postman collection for Personal Courier Delivery matching the Flutter mobile application flow.\\n\\nEnvironment: **Localhost**\\nBase URL: `http://localhost:4000/api/v1`\\n\\nFlow Coverage:\\n1. Authentication (Customer Login & Admin Dispatcher)\\n2. Service Options & Address Book (Saved Addresses & Add New)\\n3. Dynamic Quote Calculator (Weight, Dimensions, Boxes, Handling, Insurance)\\n4. Create Courier Booking (Complete 8-step payload with auto-storing `courierBookingId`)\\n5. Booking Details & Status Management\\n6. Real-time GPS Tracking & Milestones\\n7. Proof of Delivery (POD) & OTP Verification\\n8. Payment Sandbox Simulation & Order Cancellation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Authentication",
      "item": [
        {
          "name": "1. Customer Login (Sets accessToken)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"{{userMobile}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Authenticates customer and stores {{accessToken}} automatically into active Postman collection and environment."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var res = pm.response.json();",
                  "var token = (res.data && res.data.accessToken) || res.accessToken || (res.data && res.data.token) || res.token;",
                  "if (token) {",
                  "    pm.collectionVariables.set(\"accessToken\", token);",
                  "    pm.environment.set(\"accessToken\", token);",
                  "    console.log(\"accessToken set successfully\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2. Admin Login (Sets adminAccessToken)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/admin/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "auth",
                "login"
              ]
            },
            "description": "Authenticates platform administrator/dispatcher and stores {{adminAccessToken}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var res = pm.response.json();",
                  "var token = (res.data && res.data.accessToken) || res.accessToken || (res.data && res.data.token) || res.token;",
                  "if (token) {",
                  "    pm.collectionVariables.set(\"adminAccessToken\", token);",
                  "    pm.environment.set(\"adminAccessToken\", token);",
                  "    console.log(\"adminAccessToken set successfully\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "3. Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Returns profile details of the authenticated customer."
          }
        }
      ]
    },
    {
      "name": "1. Options & Address Book (Step 1 & 2)",
      "item": [
        {
          "name": "1. Get Courier Options & Service Catalog",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Contains all 8 package categories', function () {",
                  "    var jsonData = pm.response.json();",
                  "    var cats = jsonData.data.package_categories || jsonData.data.packageCategories;",
                  "    pm.expect(cats).to.be.an('array');",
                  "    pm.expect(cats.length).to.eql(8);",
                  "    var codes = cats.map(function(c) { return c.apiCode || c.id; });",
                  "    pm.expect(codes).to.include('DOCUMENTS');",
                  "    pm.expect(codes).to.include('ELECTRONICS');",
                  "    pm.expect(codes).to.include('CLOTHING_APPAREL');",
                  "});",
                  "",
                  "pm.test('Contains box types for 10, 15, and 25 Kg', function () {",
                  "    var jsonData = pm.response.json();",
                  "    var boxes = jsonData.data.box_types || jsonData.data.boxTypes;",
                  "    pm.expect(boxes).to.be.an('object');",
                  "    pm.expect(boxes['10 Kg']).to.be.an('array');",
                  "    pm.expect(boxes['15 Kg']).to.be.an('array');",
                  "    pm.expect(boxes['25 Kg']).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Contains local and intercity delivery services', function () {",
                  "    var jsonData = pm.response.json();",
                  "    var local = jsonData.data.local_options || jsonData.data.localOptions;",
                  "    var intercity = jsonData.data.intercity_options || jsonData.data.intercityOptions;",
                  "    pm.expect(local).to.be.an('array').with.lengthOf(4);",
                  "    pm.expect(intercity).to.be.an('array').with.lengthOf(5);",
                  "});",
                  "",
                  "pm.test('Contains drop options and insurance options', function () {",
                  "    var jsonData = pm.response.json();",
                  "    var drop = jsonData.data.drop_options || jsonData.data.dropOptions;",
                  "    var ins = jsonData.data.insurance_options || jsonData.data.insuranceOptions;",
                  "    pm.expect(drop).to.be.an('array').with.lengthOf(2);",
                  "    pm.expect(ins).to.be.an('array').with.lengthOf(3);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/courier-delivery/options",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "courier-delivery",
                "options"
              ]
            },
            "description": "Fetches all 6 courier service categories (Local, Intercity, Documents, Parcel, Same Day, Express), vehicle types, packaging box tiers, self-service drop options, and insurance options."
          }
        },
        {
          "name": "2. Get Saved Addresses",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/addresses",
              "host": [
