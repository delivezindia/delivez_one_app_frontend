                "courier-delivery",
                "bookings",
                "{{courierBookingId}}"
              ]
            },
            "description": "Customer updates special handling or drop-off notes."
          }
        }
      ]
    },
    {
      "name": "4. Live Tracking & Proof of Delivery (POD)",
      "item": [
        {
          "name": "1. Get Real-Time Courier Tracking & Milestones",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
