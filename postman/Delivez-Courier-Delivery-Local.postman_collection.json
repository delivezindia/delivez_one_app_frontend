            "description": "Retrieves customer saved pickup and drop-off addresses (Home, Office, Warehouse)."
          }
        },
        {
          "name": "3. Save New Address",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Office Cyber City\",\n  \"addressLine\": \"DLF Cyber City, Tower A, 6th Floor, Gurugram, Haryana 122002\",\n  \"city\": \"Gurugram\",\n  \"state\": \"Haryana\",\n  \"pincode\": \"122002\",\n  \"contactPerson\": \"Rohit Mehra\",\n  \"phone\": \"+91 98765 43211\",\n  \"instructions\": \"Please call reception upon arrival\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/addresses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "addresses"
              ]
            },
            "description": "Saves a new pickup or drop-off address into the customer address book."
          }
        }
      ]
    },
    {
      "name": "2. Price Quote Calculator",
      "item": [
        {
          "name": "1. Calculate Courier Quote",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serviceType\": \"Hybrid Drone Delivery\",\n  \"deliverySpeed\": \"Hybrid Drone Delivery\",\n  \"selfServiceOption\": \"SELF_PICKUP\",\n  \"category\": \"Clothing & Apparel\",\n  \"actualWeightKg\": 18.5,\n  \"chargeableWeightKg\": 22,\n  \"lengthCm\": 45,\n  \"widthCm\": 35,\n  \"heightCm\": 30,\n  \"needsBox\": true,\n  \"boxSize\": \"25kg\",\n  \"weightCapacity\": \"25 Kg\",\n  \"packagingType\": \"WOODEN_CRATE\",\n  \"specialHandling\": [\n    \"FRAGILE\",\n    \"EXTRA_SECURITY\"\n  ],\n  \"pickup\": {\n    \"addressLine1\": \"Connaught Place Block A\",\n    \"city\": \"New Delhi\",\n    \"postalCode\": \"110001\"\n  },\n  \"dropoff\": {\n    \"addressLine1\": \"DLF Phase 2 Cyber City\",\n    \"city\": \"Gurugram\",\n    \"postalCode\": \"122002\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/courier-delivery/quote",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "courier-delivery",
                "quote"
              ]
            },
            "description": "Calculates dynamic pricing with base delivery charge, box fees, handling safeguards, transit insurance, promo discount, and GST."
          }
        }
      ]
    },
    {
      "name": "3. Booking Creation & Management",
      "item": [
        {
          "name": "1. Create Courier Booking (Full 8-Step Payload)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "idemp-courier-{{$timestamp}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serviceType\": \"Bike Priority Delivery\",\n  \"deliverySpeed\": \"Bike Priority Delivery\",\n  \"selfServiceOption\": \"SELF_PICKUP\",\n  \"category\": \"Clothing & Apparel\",\n  \"pickup\": {\n    \"label\": \"Home Address\",\n    \"contactName\": \"Vikram Malhotra\",\n    \"phoneNumber\": \"+91 98765 43210\",\n    \"addressLine1\": \"B-1204, Lodha Park, Near Shreyas Cinema, Ghatkopar East\",\n    \"city\": \"Mumbai\",\n    \"state\": \"Maharashtra\",\n    \"postalCode\": \"400077\",\n    \"instructions\": \"Call before arriving\"\n  },\n  \"dropoff\": {\n    \"label\": \"Office Destination\",\n    \"contactName\": \"Rohit Mehra\",\n    \"phoneNumber\": \"+91 98765 43211\",\n    \"addressLine1\": \"DLF Cyber City, Tower A, 6th Floor\",\n    \"city\": \"Gurugram\",\n    \"state\": \"Haryana\",\n    \"postalCode\": \"122002\",\n    \"instructions\": \"Leave at front desk\"\n  },\n  \"package\": {\n    \"category\": \"Clothing & Apparel\",\n    \"parcelSize\": \"LARGE\",\n    \"actualWeightKg\": 14.5,\n    \"chargeableWeightKg\": 18,\n    \"lengthCm\": 45,\n    \"widthCm\": 35,\n    \"heightCm\": 30,\n    \"dimensions\": {\n      \"lengthCm\": 45,\n      \"widthCm\": 35,\n      \"heightCm\": 30\n    },\n    \"needsBox\": true,\n    \"boxSize\": \"Large Box (25 Kg)\",\n    \"weightCapacity\": \"25 Kg\",\n    \"isCustomBox\": true,\n    \"customBoxDetails\": {\n      \"length\": 45,\n      \"width\": 35,\n      \"height\": 30,\n      \"notes\": \"Reinforced double-wall apparel box\"\n    },\n    \"packagingType\": \"WOODEN_CRATE\",\n    \"fragile\": true,\n    \"secureHandling\": true,\n    \"specialHandling\": true,\n    \"contentDescription\": \"Designer clothing sample collection\",\n    \"declaredValue\": 45000,\n    \"insuranceType\": \"FULL\"\n  },\n  \"paymentMethod\": \"ONLINE\",\n  \"promoCode\": \"DELIVEZ10\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/courier-delivery/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "courier-delivery",
                "bookings"
              ]
            },
            "description": "Creates a new courier consignment booking and automatically stores {{courierBookingId}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 or 200\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "var res = pm.response.json();",
                  "var id = (res.data && res.data.booking && (res.data.booking.bookingNumber || res.data.booking.id)) || (res.data && (res.data.bookingId || res.data.id)) || res.bookingId || res.id;",
                  "if (id) {",
                  "    pm.collectionVariables.set(\"courierBookingId\", id);",
                  "    pm.environment.set(\"courierBookingId\", id);",
                  "    console.log(\"courierBookingId set: \" + id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2. Get All Courier Bookings (Paginated)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
